<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base window theme (light). All Material 3 colouring is done in Compose;
         this only provides an action-bar-less, edge-to-edge window. Uses a
         framework parent so no extra View libraries are needed. -->
    <style name="Theme.AdrenoTurbo" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

</resources>
